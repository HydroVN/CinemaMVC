@model List<MVCDatVePhim.Models.DatVe>
@{
    ViewData["Title"] = "Vé Của Tôi";
}

<div class="container" style="padding-top:2.5rem; padding-bottom:3rem">
    <h1 style="font-size:1.6rem; font-weight:800; margin-bottom:1.5rem">
        <i class="bi bi-ticket-perforated text-gold"></i> Vé Của Tôi
    </h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-ticket" style="font-size:4rem; color:#2a2a40; display:block; margin-bottom:1rem"></i>
            <p class="text-muted-cine">Bạn chưa đặt vé nào.</p>
            <a class="btn-cine" asp-controller="Phim" asp-action="Index">
                <i class="bi bi-film"></i> Tìm Phim Ngay
            </a>
        </div>
    }
    else
    {
        @foreach (var ve in Model)
        {
            var sc       = ve.SuatChieu;
            var isFuture = sc.ThoiGianBatDau > DateTime.Now;

            <div class="cine-card mb-3" style="border-left: 4px solid
                @(ve.TrangThai == MVCDatVePhim.Models.TrangThaiDatVe.DaHuy ? "#e57373"
                : isFuture ? "#81c784" : "#2a2a40")">
                <div class="row g-3 align-items-center">
                    <div class="col-md-2 col-3">
                        <img src="@sc.Phim.UrlAnh" alt="@sc.Phim.TenPhim"
                             style="width:100%; aspect-ratio:2/3; object-fit:cover; border-radius:8px" />
                    </div>
                    <div class="col-md-7 col-9">
                        <h5 style="font-size:1rem; font-weight:700; margin-bottom:.3rem">@sc.Phim.TenPhim</h5>
                        <div class="d-flex flex-wrap gap-2 mb-2" style="font-size:.82rem; color:#9e9e9e">
                            <span><i class="bi bi-calendar3"></i> @sc.ThoiGianBatDau.ToString("dd/MM/yyyy")</span>
                            <span><i class="bi bi-clock"></i> @sc.ThoiGianHienThi</span>
                            <span><i class="bi bi-building"></i> @sc.PhongChieu?.RapChieu?.TenRap</span>
                        </div>
                        <div style="font-size:.85rem">
                            <span class="text-muted-cine">Ghế: </span>
                            <span class="text-gold fw-semibold">
                                @string.Join(", ", ve.ChiTietDatVes.Select(c => c.Ghe.NhanGhe))
                            </span>
                        </div>
                        <div style="font-size:.8rem; margin-top:.25rem">
                            <span class="text-muted-cine">Mã vé: </span>
                            <code style="color:#4fc3f7; background:rgba(79,195,247,.1); padding:.1rem .4rem; border-radius:4px">
                                @ve.MaVe
                            </code>
                        </div>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <div style="font-size:1.1rem; font-weight:800; color:#f5c518; margin-bottom:.5rem">
                            @ve.TongTien.ToString("N0") VNĐ
                        </div>
                        @{
                            var (badgeClass, badgeText) = ve.TrangThai switch
                            {
                                MVCDatVePhim.Models.TrangThaiDatVe.DaXacNhan => ("badge-xacnhan", "Đã Xác Nhận"),
                                MVCDatVePhim.Models.TrangThaiDatVe.DaHuy     => ("badge-huy",     "Đã Huỷ"),
                                _                                             => ("badge-cho",     "Chờ Xác Nhận"),
                            };
                        }
                        <span class="badge @badgeClass mb-2">@badgeText</span>

                        @if (ve.TrangThai != MVCDatVePhim.Models.TrangThaiDatVe.DaHuy && isFuture)
                        {
                            <form asp-controller="DatVe" asp-action="Huy" asp-route-id="@ve.Id"
                                  method="post" class="d-block"
                                  onsubmit="return confirm('Bạn có chắc muốn huỷ vé này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-outline-cine" style="font-size:.8rem; color:#e57373; border-color:#3a1a1a">
                                    <i class="bi bi-x-circle"></i> Huỷ Vé
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
