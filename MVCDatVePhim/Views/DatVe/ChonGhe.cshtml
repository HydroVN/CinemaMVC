@model MVCDatVePhim.ViewModels.ChonGheViewModel
@{
    ViewData["Title"] = "Chọn Ghế";
    var sc = Model.SuatChieu;
}

@section Styles {
    <input type="hidden" id="giaVe" value="@sc.GiaVe" />
}

<div class="container" style="padding-top:2rem; padding-bottom:3rem">

    <!-- Error toast -->
    @if (TempData["LoiGhe"] != null)
    {
        <div class="alert-cine mb-3"><i class="bi bi-exclamation-triangle"></i> @TempData["LoiGhe"]</div>
    }

    <!-- Header info -->
    <div class="cine-card mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-2 text-center">
                <img src="@sc.Phim.UrlAnh" alt="@sc.Phim.TenPhim"
                     style="width:70px; aspect-ratio:2/3; object-fit:cover; border-radius:8px" />
            </div>
            <div class="col-md-7">
                <h2 style="font-size:1.4rem; font-weight:800; margin-bottom:.3rem">@sc.Phim.TenPhim</h2>
                <div class="d-flex flex-wrap gap-3" style="font-size:.85rem; color:#9e9e9e">
                    <span><i class="bi bi-calendar3"></i> @sc.ThoiGianBatDau.ToString("dddd, dd/MM/yyyy")</span>
                    <span><i class="bi bi-clock"></i> @sc.ThoiGianHienThi</span>
                    <span><i class="bi bi-building"></i> @sc.PhongChieu?.RapChieu?.TenRap</span>
                    <span><i class="bi bi-door-open"></i> Phòng @sc.PhongChieu?.TenPhong</span>
                </div>
            </div>
            <div class="col-md-3 text-md-end">
                <div style="font-size:.85rem; color:#9e9e9e">Giá vé thường</div>
                <div style="font-size:1.5rem; font-weight:800; color:#f5c518">
                    @sc.GiaVe.ToString("N0") <span style="font-size:.9rem; font-weight:400">VNĐ</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Seat Map -->
        <div class="col-lg-8">
            <div class="cine-card">
                <div class="screen-label">🎬 MÀN HÌNH</div>

                <!-- Legend -->
                <div class="seat-legend">
                    <div class="legend-item">
                        <div class="legend-box" style="background:#2a4a2a"></div>
                        <span style="color:#9e9e9e;font-size:.8rem">Trống</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-box" style="background:#f5c518"></div>
                        <span style="color:#9e9e9e;font-size:.8rem">Đang chọn</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-box" style="background:#3a1a1a"></div>
                        <span style="color:#9e9e9e;font-size:.8rem">Đã đặt</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-box" style="background:#2a2a5a"></div>
                        <span style="color:#9e9e9e;font-size:.8rem">VIP (+50%)</span>
                    </div>
                </div>

                <!-- Seat Grid -->
                <div class="seat-map-container">
                    @{
                        var gheTheoHang = Model.DanhSachGhe.GroupBy(g => g.HangGhe).OrderBy(g => g.Key);
                    }
                    @foreach (var hang in gheTheoHang)
                    {
                        <div class="seat-row">
                            <div class="seat-row-label">@hang.Key</div>
                            @foreach (var ghe in hang.OrderBy(g => g.SoGhe))
                            {
                                var daDat  = Model.GheDaDat.Contains(ghe.Id);
                                var loaiClass = daDat ? "seat-booked"
                                              : ghe.LoaiGhe == MVCDatVePhim.Models.LoaiGhe.VIP
                                                    ? "seat-vip" : "seat-available";

                                <button type="button"
                                        class="seat @loaiClass"
                                        data-id="@ghe.Id"
                                        data-nhan="@ghe.NhanGhe"
                                        data-loai="@ghe.LoaiGhe"
                                        title="Ghế @ghe.NhanGhe — @ghe.LoaiGhe.GetDisplayName()"
                                        @(daDat ? "disabled" : "")>
                                    @ghe.SoGhe
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Summary Panel -->
        <div class="col-lg-4">
            <div class="cine-card" style="position:sticky; top:100px">
                <h5 style="font-weight:700; margin-bottom:1rem">📋 Tóm Tắt Đặt Vé</h5>

                <div class="booking-summary-row">
                    <span class="text-muted-cine">Số ghế đã chọn</span>
                    <span id="soGheDaChon" style="font-weight:600">0</span>
                </div>
                <div class="booking-summary-row">
                    <span class="text-muted-cine">Ghế</span>
                    <span id="danhSachGhe" style="font-weight:600; color:#f5c518">—</span>
                </div>
                <div class="booking-summary-total">
                    <span>Tổng Tiền</span>
                    <span id="tongTien">0 ₫</span>
                </div>

                <form id="chonGheForm"
                      asp-controller="DatVe" asp-action="XacNhan"
                      method="post" style="margin-top:1.25rem">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="suatChieuId" value="@sc.Id" />

                    <button type="submit" id="btnXacNhan" class="btn-cine w-100" disabled>
                        <i class="bi bi-arrow-right-circle-fill"></i> Xác Nhận Chọn Ghế
                    </button>
                </form>

                <div style="font-size:.75rem; color:#666; margin-top:.75rem; text-align:center">
                    <i class="bi bi-shield-check"></i> Ghế được giữ trong 10 phút
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chon-ghe.js" asp-append-version="true"></script>
}
