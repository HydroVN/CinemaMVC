<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — CineViet" : "CineViet | Đặt Vé Xem Phim Trực Tuyến")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "CineViet — Đặt vé xem phim trực tuyến nhanh chóng, tiện lợi với hàng trăm bộ phim hot nhất.")" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts (preconnect) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ── Navbar ──────────────────────────────────────────── -->
<nav class="navbar navbar-cine navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand navbar-brand-text" asp-controller="Home" asp-action="Index">
            🎬 CineViet<span>Đặt vé không lo</span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navMain" aria-label="Mở menu">
            <span class="navbar-toggler-icon" style="filter:invert(1)"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav mx-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link-cine" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Trang Chủ
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link-cine" asp-controller="Phim" asp-action="Index">
                        <i class="bi bi-film"></i> Phim Đang Chiếu
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link-cine" asp-controller="Phim" asp-action="Index"
                       asp-route-theLoai="">
                        <i class="bi bi-calendar-event"></i> Phim Sắp Chiếu
                    </a>
                </li>
            </ul>

            <!-- Search -->
            <form class="d-flex me-3" asp-controller="Phim" asp-action="Index" method="get">
                <div class="input-group" style="width:230px">
                    <input type="text" name="tuKhoa" class="form-control form-control-sm form-control-cine"
                           placeholder="Tìm phim..." value="@ViewBag.TuKhoa" />
                    <button class="btn btn-cine btn-sm" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            <!-- Auth -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="btn-outline-cine dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        @User.Identity.Name?.Split('@')[0]
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end"
                        style="background:#1a1a2e; border:1px solid #2a2a40; min-width:160px">
                        <li>
                            <a class="dropdown-item text-light" style="font-size:.88rem"
                               asp-controller="DatVe" asp-action="VeCuaToi">
                                <i class="bi bi-ticket-perforated me-2"></i>Vé Của Tôi
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a class="dropdown-item text-light" style="font-size:.88rem"
                                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-gear me-2"></i>Quản Trị
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider" style="border-color:#2a2a40" /></li>
                        <li>
                            <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                                <button class="dropdown-item text-danger" style="font-size:.88rem">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng Xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <div class="d-flex gap-2">
                    <a class="btn-outline-cine" asp-controller="TaiKhoan" asp-action="DangNhap">
                        Đăng Nhập
                    </a>
                    <a class="btn-cine" asp-controller="TaiKhoan" asp-action="DangKy">
                        Đăng Ký
                    </a>
                </div>
            }
        </div>
    </div>
</nav>

<!-- ── Global alert from TempData ──────────────────────── -->
@if (TempData["ThongBao"] != null)
{
    <div class="container mt-3">
        <div class="alert-cine alert-cine-success d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i> @TempData["ThongBao"]
        </div>
    </div>
}

<!-- ── Main content ─────────────────────────────────────── -->
<main>
    @RenderBody()
</main>

<!-- ── Footer ───────────────────────────────────────────── -->
<footer>
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div style="font-size:1.4rem; font-weight:800; color:#e50914; margin-bottom:.5rem">
                    🎬 CineViet
                </div>
                <p style="color:#9e9e9e; font-size:.85rem; line-height:1.7">
                    Đặt vé xem phim trực tuyến nhanh chóng, tiện lợi.
                    Trải nghiệm điện ảnh đẳng cấp tại hàng trăm rạp trên toàn quốc.
                </p>
            </div>
            <div class="col-lg-2">
                <h6>Phim</h6>
                <ul class="list-unstyled">
                    <li><a href="#">Đang Chiếu</a></li>
                    <li><a href="#">Sắp Chiếu</a></li>
                    <li><a href="#">Phim Hay</a></li>
                </ul>
            </div>
            <div class="col-lg-2">
                <h6>Hỗ Trợ</h6>
                <ul class="list-unstyled">
                    <li><a href="#">Câu Hỏi Thường Gặp</a></li>
                    <li><a href="#">Chính Sách Hoàn Tiền</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                </ul>
            </div>
            <div class="col-lg-4">
                <h6>Liên Hệ</h6>
                <ul class="list-unstyled" style="font-size:.85rem; color:#9e9e9e">
                    <li><i class="bi bi-envelope me-2"></i>support@@cineviet.vn</li>
                    <li><i class="bi bi-telephone me-2"></i>1900-6868</li>
                    <li><i class="bi bi-geo-alt me-2"></i>TP. Hồ Chí Minh, Việt Nam</li>
                </ul>
            </div>
        </div>
        <hr style="border-color:#2a2a40; margin-top:2rem" />
        <p class="text-center mb-0" style="font-size:.8rem; color:#666">
            &copy; 2026 CineViet. Tất cả quyền được bảo lưu.
        </p>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
