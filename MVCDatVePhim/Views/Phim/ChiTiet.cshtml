@model MVCDatVePhim.Models.Phim
@{
    ViewData["Title"] = Model.TenPhim;
    var suatChieuNhom = Model.DanhSachSuatChieu
        .Where(s => s.DangHoatDong && s.ThoiGianBatDau >= DateTime.Now)
        .GroupBy(s => s.ThoiGianBatDau.Date)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="container" style="padding-top:2.5rem; padding-bottom:3rem">

    <a class="btn-outline-cine mb-4" asp-controller="Phim" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Quay Lại
    </a>

    <div class="row g-4">
        <!-- Poster -->
        <div class="col-md-3">
            <img src="@(string.IsNullOrEmpty(Model.UrlAnh) ? "https://via.placeholder.com/300x450/1a1a2e/555?text=Poster" : Model.UrlAnh)"
                 alt="@Model.TenPhim"
                 class="img-fluid rounded"
                 style="width:100%; aspect-ratio:2/3; object-fit:cover; border:2px solid #2a2a40" />
        </div>

        <!-- Info -->
        <div class="col-md-5">
            <h1 style="font-size:1.9rem; font-weight:800; margin-bottom:.5rem">@Model.TenPhim</h1>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge" style="background:rgba(229,9,20,.15); color:#e50914; font-size:.8rem">
                    @Model.TheLoai.GetDisplayName()
                </span>
                <span class="badge" style="background:rgba(245,197,24,.15); color:#f5c518; font-size:.8rem">
                    ⭐ @Model.DanhGia.ToString("F1") / 10
                </span>
                <span class="badge" style="background:rgba(255,255,255,.07); color:#ddd; font-size:.8rem">
                    <i class="bi bi-clock"></i> @Model.ThoiLuong phút
                </span>
            </div>

            <div class="cine-card mb-3">
                <div class="row g-2" style="font-size:.88rem">
                    <div class="col-5 text-muted-cine">Đạo diễn</div>
                    <div class="col-7">@(Model.DaoDien.Length > 0 ? Model.DaoDien : "—")</div>
                    <div class="col-5 text-muted-cine">Diễn viên</div>
                    <div class="col-7">@(Model.DienVien.Length > 0 ? Model.DienVien : "—")</div>
                    <div class="col-5 text-muted-cine">Ngôn ngữ</div>
                    <div class="col-7">@Model.NgonNgu</div>
                    <div class="col-5 text-muted-cine">Ngày chiếu</div>
                    <div class="col-7">@Model.NgayKhoiChieu.ToString("dd/MM/yyyy")</div>
                    <div class="col-5 text-muted-cine">Trạng thái</div>
                    <div class="col-7">
                        @if (Model.DangChieu)
                        {
                            <span style="color:#81c784"><i class="bi bi-circle-fill" style="font-size:.5rem"></i> Đang Chiếu</span>
                        }
                        else
                        {
                            <span style="color:#f5c518"><i class="bi bi-circle-fill" style="font-size:.5rem"></i> Sắp Chiếu</span>
                        }
                    </div>
                </div>
            </div>

            <div style="color:#ccc; font-size:.9rem; line-height:1.7; margin-bottom:1.5rem">
                @Model.MoTa
            </div>

            @if (!string.IsNullOrEmpty(Model.UrlTrailer))
            {
                <a href="@Model.UrlTrailer" target="_blank" class="btn-outline-cine mb-3">
                    <i class="bi bi-play-circle-fill text-red"></i> Xem Trailer
                </a>
            }
        </div>

        <!-- Chọn Suất Chiếu -->
        <div class="col-md-4">
            <div class="cine-card">
                <h5 style="font-weight:700; margin-bottom:1rem">🎟️ Chọn Suất Chiếu</h5>

                @if (!suatChieuNhom.Any())
                {
                    <p class="text-muted-cine small">Hiện chưa có suất chiếu nào.</p>
                }
                else
                {
                    @foreach (var nhom in suatChieuNhom.Take(5))
                    {
                        <div style="margin-bottom:1rem">
                            <div style="font-size:.8rem; font-weight:700; color:#f5c518; margin-bottom:.5rem">
                                📅 @nhom.Key.ToString("dddd, dd/MM/yyyy")
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var sc in nhom.OrderBy(s => s.ThoiGianBatDau))
                                {
                                    <a asp-controller="DatVe" asp-action="ChonGhe" asp-route-id="@sc.Id"
                                       class="btn-outline-cine"
                                       style="font-size:.8rem; padding:.35rem .8rem"
                                       title="@sc.PhongChieu?.TenPhong — @(sc.GiaVe.ToString("N0")) VNĐ">
                                        @sc.ThoiGianBatDau.ToString("HH:mm")
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    <a class="btn-cine w-100 mt-2" asp-controller="SuatChieu" asp-action="TheoBo" asp-route-id="@Model.Id">
                        <i class="bi bi-calendar3"></i> Xem Lịch Chiếu Đầy Đủ
                    </a>
                }
            </div>
        </div>
    </div>
</div>
