@model List<MVCDatVePhim.Models.Phim>
@{
    ViewData["Title"] = "Quản Lý Phim";
    ViewData["BreadcrumbParent"] = "Nội Dung";
}

<div class="admin-page-header">
    <h1 class="admin-page-title">Quản Lý Phim</h1>
    <a class="btn-admin-primary" asp-area="Admin" asp-controller="Phim" asp-action="TaoMoi">
        <i class="bi bi-plus-circle me-1"></i> Thêm Phim Mới
    </a>
</div>

<div class="admin-card">
    <table class="table admin-table mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Poster</th>
                <th>Tên Phim</th>
                <th>Thể Loại</th>
                <th>Đánh Giá</th>
                <th>Ngày Chiếu</th>
                <th>Trạng Thái</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var phim in Model)
            {
                var confirmMsg = $"Xoá phim \"{phim.TenPhim}\"?";
                <tr>
                    <td>@phim.Id</td>
                    <td>
                        <img src="@phim.UrlAnh"
                             style="width:40px; height:56px; object-fit:cover; border-radius:4px; background:#1a1a2e"
                             alt="@phim.TenPhim" />
                    </td>
                    <td>
                        <div style="font-weight:600; max-width:200px">@phim.TenPhim</div>
                        <div style="font-size:.78rem; color:#7a7a9a">@phim.ThoiLuong phút · @phim.NgonNgu</div>
                    </td>
                    <td>@phim.TheLoai.GetDisplayName()</td>
                    <td><span style="color:#f5c518">⭐ @phim.DanhGia.ToString("F1")</span></td>
                    <td style="font-size:.85rem">@phim.NgayKhoiChieu.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (phim.DangChieu)
                        {
                            <span class="badge badge-xacnhan">Đang Chiếu</span>
                        }
                        else
                        {
                            <span class="badge badge-cho">Sắp Chiếu</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm"
                               style="background:rgba(79,195,247,.1); color:#4fc3f7; border-color:rgba(79,195,247,.2)"
                               asp-area="Admin" asp-controller="Phim" asp-action="ChinhSua"
                               asp-route-id="@phim.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-area="Admin" asp-controller="Phim" asp-action="Xoa"
                                  asp-route-id="@phim.Id" method="post"
                                  onsubmit="@($"return confirm('{confirmMsg}')")">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm"
                                        style="background:rgba(229,9,20,.1); color:#e57373; border-color:rgba(229,9,20,.2)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="text-center py-4" style="color:#7a7a9a">
            <i class="bi bi-film" style="font-size:2.5rem; display:block; margin-bottom:.5rem"></i>
            Chưa có phim nào. <a asp-area="Admin" asp-controller="Phim" asp-action="TaoMoi" style="color:#e50914">Thêm ngay</a>
        </div>
    }
</div>
